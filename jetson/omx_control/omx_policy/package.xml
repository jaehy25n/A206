<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_policy</name>
  <version>0.1.0</version>
  <description>Policy node interface for the OMX stack. Ships a scripted dummy policy with the same topics as the trained model will have.</description>
  <maintainer email="wogus061@gmail.com">jK</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>omx_msgs</depend>
  <depend>omx_task_control</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
