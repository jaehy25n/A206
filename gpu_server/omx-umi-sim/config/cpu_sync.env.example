# CPU (EC2) -> GPU processed-dataset sync.
#
#   cp config/cpu_sync.env.example ~/umi-gpu/config/cpu_sync.env
#   $EDITOR ~/umi-gpu/config/cpu_sync.env
#
# Never commit the filled-in file: it is in .gitignore, and no host or key path
# belongs in Python code.

# --- CPU side (read-only source) -------------------------------------------- #
CPU_USER=ubuntu
CPU_HOST=<EC2_HOST>
CPU_PROCESSED_ROOT=/srv/processed/v1

# --- GPU side (local mirror) ------------------------------------------------ #
# The handoff spec names /data/dataset/v1. This box has no root and no /data
# mount, while /home has ~11 TB free, so only the ROOT moves: the processed/v1
# namespace is kept so the path names what it mirrors,
#   <cpu>:/srv/processed/v1  ->  <gpu>:~/omx_data/processed/v1
# Point this anywhere; scripts and omx/config.py both read it.
GPU_PROCESSED_ROOT=$HOME/omx_data/processed/v1

# --- SSH -------------------------------------------------------------------- #
#   ssh-keygen -t ed25519 -f ~/.ssh/tiger_cpu_sync
#   cat ~/.ssh/tiger_cpu_sync.pub        # register on the EC2 account
SSH_KEY=$HOME/.ssh/tiger_cpu_sync
SSH_PORT=22

# Extra rsync flags. --bwlimit is useful on a shared link.
# RSYNC_EXTRA_FLAGS=--bwlimit=50M
