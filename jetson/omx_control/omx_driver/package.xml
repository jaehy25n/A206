<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_driver</name>
  <version>0.1.0</version>
  <description>Minimal Dynamixel driver node for the OMX-F arm: 100 Hz SyncRead/SyncWrite, command timeout hold, joint limit clamping, mock mode.</description>
  <maintainer email="wogus061@gmail.com">J</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>dynamixel_sdk</depend>
  <depend>omx_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
