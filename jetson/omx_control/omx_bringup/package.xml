<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and shared configuration for the OMX policy-control stack (mock and real robot), plus a live ROS graph dump tool.</description>
  <maintainer email="wogus061@gmail.com">J</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>omx_description</exec_depend>
  <exec_depend>omx_driver</exec_depend>
  <exec_depend>omx_perception</exec_depend>
  <exec_depend>omx_policy</exec_depend>
  <exec_depend>omx_task_control</exec_depend>
  <exec_depend>omx_supervisor</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
