<mujoco model="virtual_umi_collector">

  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002"
          gravity="0 0 -9.81"
          integrator="implicitfast"/>

  <visual>
    <global offwidth="320" offheight="240"/>
  </visual>

  <default>
    <joint damping="1"/>
    <geom friction="2 0.1 0.01" condim="4"/>
  </default>

  <worldbody>

    <light pos="0 -0.5 2"
           dir="0 0 -1"
           directional="true"/>

    <geom name="floor"
          type="plane"
          size="2 2 0.1"
          rgba="0.75 0.75 0.75 1"/>

    <!-- place target -->
    <geom name="target_zone"
          type="box"
          pos="0 0.55 0.002"
          size="0.07 0.07 0.002"
          rgba="0.3 0.8 0.3 0.35"
          contype="0"
          conaffinity="0"/>

    <!-- 사람이 들고 움직이는 가상의 target -->
    <body name="mocap_target"
          mocap="true"
          pos="0 0.10 0.06">
    </body>

    <!-- 실제 virtual collector -->
    <body name="collector"
          pos="0 0.10 0.06">

      <freejoint/>

      <inertial pos="0 0 0"
                mass="0.3"
                diaginertia="0.002 0.002 0.002"/>

      <!-- wrist camera -->
      <camera name="wrist"
              pos="0 -0.02 0.13"
              xyaxes="1 0 0 0 0.45 0.893"
              fovy="60"/>

      <!-- TCP -->
      <site name="tcp"
            pos="0 0.18 -0.035"
            size="0.005"
            rgba="1 0 0 0"/>

      <!-- LEFT FINGER -->
      <body name="left_finger"
            pos="-0.055 0 -0.035">

        <joint name="left_slide"
               type="slide"
               axis="1 0 0"
               range="0 0.035"
               damping="2"/>

        <geom name="left_finger_geom"
              type="box"
              pos="0 0.10 0"
              size="0.008 0.08 0.015"
              mass="0.03"
              friction="3 0.1 0.01"
              rgba="0.9 0.9 0.9 1"/>

        <site name="left_inner"
              pos="0.008 0.17 0"
              size="0.002"/>

      </body>

      <!-- RIGHT FINGER -->
      <body name="right_finger"
            pos="0.055 0 -0.035">

        <joint name="right_slide"
               type="slide"
               axis="1 0 0"
               range="-0.035 0"
               damping="2"/>

        <geom name="right_finger_geom"
              type="box"
              pos="0 0.10 0"
              size="0.008 0.08 0.015"
              mass="0.03"
              friction="3 0.1 0.01"
              rgba="0.9 0.9 0.9 1"/>

        <site name="right_inner"
              pos="-0.008 0.17 0"
              size="0.002"/>

      </body>

    </body>

    <!-- pick 대상 -->
    <body name="object"
          pos="0 0.28 0.025">

      <freejoint/>

      <geom name="object_geom"
            type="box"
            size="0.025 0.025 0.025"
            mass="0.08"
            friction="3 0.1 0.01"
            rgba="0.2 0.45 0.9 1"/>

    </body>

  </worldbody>

  <!-- mocap target을 따라 collector가 움직임 -->
  <equality>
    <weld body1="collector"
          body2="mocap_target"
          relpose="0 0 0 1 0 0 0"
          solref="0.002 1"/>
  </equality>

  <actuator>

    <position name="left_act"
              joint="left_slide"
              kp="300"
              ctrlrange="0 0.035"/>

    <position name="right_act"
              joint="right_slide"
              kp="300"
              ctrlrange="-0.035 0"/>

  </actuator>

</mujoco>
