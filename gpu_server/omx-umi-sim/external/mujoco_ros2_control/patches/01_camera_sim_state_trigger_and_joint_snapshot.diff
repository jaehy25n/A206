+void CameraPlugin::pre_step(mjData* data)
+{
+  // physics thread, immediately before mj_step, sim mutex held: `data` is the tick's state
+  if (!sim_state_trigger_ || !publish_images_ || !has_streaming_cameras_)
+  {
+    return;
+  }
+  const bool due = (steps_since_reset_ % sim_state_period_steps_) == 0;
+  ++steps_since_reset_;
+  if (!due)
+  {
+    return;
+  }
+  {
+    std::unique_lock<std::mutex> lock(data_mutex_);
+    data_consumed_cv_.wait(lock, [this] { return (!new_data_ && !render_busy_) || stop_requested_; });
+    if (stop_requested_)
+    {
+      return;
+    }
+    for (auto& camera : cameras_)
+    {
+      if (camera.policy == CameraPolicy::STREAMING)
+      {
+        camera.render_pending = true;
+      }
+    }
+    // The positions the renderer reads (body / geom / camera / light poses) are whatever the
+    // last kinematics pass left: after a step they belong to the PREVIOUS qpos unless an idle
+    // mj_forward ran in between (the paused loop does one per idle iteration; back-to-back
+    // queued steps do not). Recompute them from this tick's qpos so the image and the joint
+    // snapshot are the same tick t. The next mj_step recomputes all of it from qpos anyway.
+    mj_kinematics(mj_model_, data);
+    mj_camlight(mj_model_, data);
+    mjv_copyData(mj_camera_data_, mj_model_, data);
+    new_data_ = true;
+  }
+  data_cv_.notify_one();
+}
+
+void CameraPlugin::on_reset(mjData* /*data*/)
+{
+  // the capture schedule restarts with the world: the first step after a reset captures
+  steps_since_reset_ = 0;
+}
