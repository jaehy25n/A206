[Unit]
Description=Capture Ingestion Server
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/server

Environment=PYTHONUNBUFFERED=1

ExecStart=/home/ubuntu/server/.venv/bin/uvicorn \
    main:app \
    --host 127.0.0.1 \
    --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
