<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_teach</name>
  <version>0.1.0</version>
  <description>Kinesthetic teach and replay for the OMX-F follower: record /joint_states while moving the arm by hand, replay through the omx_control mode_manager (TELEOP).</description>
  <maintainer email="wogus061@gmail.com">J</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>omx_teach_msgs</depend>
  <depend>python3-numpy</depend>

  <!-- optional at runtime: mode confirmation and TCP export use the omx_control stack -->
  <exec_depend>omx_msgs</exec_depend>
  <exec_depend>omx_task_control</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
