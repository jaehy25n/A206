<?xml version="1.0" ?>
<!--
  OMX-F follower arm (5 DOF + gripper) for the omx policy-control stack.

  Written by hand for this project. Link geometry (joint origins, axes, masses,
  inertias) and the STL meshes are taken from ROBOTIS open_manipulator
  (open_manipulator_description/urdf/omx_f, Apache-2.0). Differences from the
  ROBOTIS file:
    * root link is base_link (was world -> link0)
    * joint limits are the SAFE operating limits used by the driver/IK, not +-2*pi
      (still TODO: verify on hardware, see omx_bringup/config/joint_limits.yaml)
    * added tcp (tool centre point) and wrist_camera_link / wrist_camera_optical_frame
      TODO: calibrate both offsets; the values below are placeholders
    * no ros2_control / gazebo blocks
-->
<robot name="omx_f">

  <material name="grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="red"><color rgba="1.0 0.0 0.0 1"/></material>
  <material name="camera"><color rgba="0.1 0.3 0.8 1"/></material>

  <!-- ===================== base ===================== -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_01_base.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_01_base.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <!-- no <inertial> on the root link: KDL (robot_state_publisher) rejects it -->
  </link>

  <!-- ===================== joint1: base yaw (z) ===================== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin rpy="0 0 0" xyz="-0.01125 0 0.034"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" lower="-3.1416" upper="3.1416" velocity="4.8"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_02_base_tilt_Revised.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_02_base_tilt_Revised.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-6.223620500e-06 6.049232000e-04 4.741880300e-02"/>
      <mass value="6.598704100e-02"/>
      <inertia ixx="2.173166700e-05" ixy="-7.670221200e-09" ixz="6.604697700e-09" iyy="2.135151300e-05" iyz="-3.790671700e-07" izz="1.165795500e-05"/>
    </inertial>
  </link>

  <!-- ===================== joint2: shoulder pitch (y) ===================== -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 0 0" xyz="0 0 0.0635"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" lower="-1.868" upper="1.658" velocity="4.8"/>
    <dynamics damping="0.1"/>
  </joint>
  <link name="link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_03_middle_verticle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_03_middle_verticle.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="1.808991600e-02 2.977875800e-04 9.900545200e-02"/>
      <mass value="8.722147100e-02"/>
      <inertia ixx="1.030791500e-04" ixy="-9.237869700e-07" ixz="-2.259657800e-05" iyy="1.208632700e-04" iyz="-1.937414500e-06" izz="4.199367700e-05"/>
    </inertial>
  </link>

  <!-- ===================== joint3: elbow pitch (y) ===================== -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 0" xyz="0.0415 0 0.11315"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" lower="-1.571" upper="1.675" velocity="4.8"/>
    <dynamics damping="0.1"/>
  </joint>
  <link name="link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_04_middle_horizontal.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_04_middle_horizontal.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="8.739860200e-02 4.131006500e-04 -3.582921000e-03"/>
      <mass value="8.375912900e-02"/>
      <inertia ixx="1.520310100e-05" ixy="-5.856958300e-07" ixz="-8.201398200e-06" iyy="2.260615800e-04" iyz="4.169928000e-07" izz="2.306688700e-04"/>
    </inertial>
  </link>

  <!-- ===================== joint4: wrist pitch (y) ===================== -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="0 0 0" xyz="0.162 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.5" lower="-1.745" upper="1.745" velocity="4.8"/>
    <dynamics damping="0.1"/>
  </joint>
  <link name="link4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_05_tip.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_05_tip.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="2.323498000e-02 6.773537800e-05 5.976131200e-03"/>
      <mass value="2.997506300e-02"/>
      <inertia ixx="5.099513000e-06" ixy="2.633166800e-08" ixz="-7.760319700e-07" iyy="7.099047100e-06" iyz="1.637967900e-09" izz="6.311949500e-06"/>
    </inertial>
  </link>

  <!-- ===================== joint5: wrist roll (x) ===================== -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="0 0 0" xyz="0.0287 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="0.5" lower="-3.1416" upper="3.1416" velocity="4.8"/>
    <dynamics damping="0.1"/>
  </joint>
  <link name="link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_06_pan_Revised.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_06_pan_Revised.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="2.807240700e-02 2.413594100e-05 1.352891400e-02"/>
      <mass value="4.381088700e-02"/>
      <inertia ixx="2.369445900e-05" ixy="-2.614252600e-08" ixz="-2.939284100e-06" iyy="2.323692400e-05" iyz="7.543040500e-08" izz="7.180629100e-06"/>
    </inertial>
  </link>

  <!-- ===================== gripper ===================== -->
  <joint name="gripper_joint_1" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="0 0 0" xyz="0.0295 0.0075 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.5" lower="0.0" upper="1.745" velocity="4.8"/>
    <dynamics damping="0.1"/>
  </joint>
  <link name="link6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_07_gripper_motorized.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_07_gripper_motorized.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="1.616456500e-02 1.273103200e-03 2.729159800e-04"/>
      <mass value="1.209067700e-02"/>
      <inertia ixx="2.708328700e-06" ixy="1.397245300e-07" ixz="5.888794300e-08" iyy="6.873372800e-06" iyz="1.537070800e-08" izz="4.694188100e-06"/>
    </inertial>
  </link>

  <joint name="gripper_joint_2" type="revolute">
    <parent link="link5"/>
    <child link="link7"/>
    <origin rpy="0 0 0" xyz="0.0295 -0.0108 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.5" lower="-1.745" upper="0.0" velocity="4.8"/>
    <dynamics damping="0.1"/>
    <mimic joint="gripper_joint_1" multiplier="-1"/>
  </joint>
  <link name="link7">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_08_gripper_gear.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://omx_description/meshes/omx_f/follower_08_gripper_gear.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="1.616456500e-02 1.273103200e-03 2.729159800e-04"/>
      <mass value="1.209067700e-02"/>
      <inertia ixx="2.708328700e-06" ixy="1.397245300e-07" ixz="5.888794300e-08" iyy="6.873372800e-06" iyz="1.537070800e-08" izz="4.694188100e-06"/>
    </inertial>
  </link>

  <!-- ===================== end effector / TCP ===================== -->
  <!-- ROBOTIS end_effector_link: 91.93 mm along link5 x. Kept for reference. -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/>
    <child link="end_effector_link"/>
    <origin rpy="0 0 0" xyz="0.09193 -0.0016 0"/>
  </joint>
  <link name="end_effector_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.008 0.008 0.008"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- tcp: the frame the policy acts on (between the finger tips).
       TODO calibrate. Offset from end_effector_link is currently zero; keep it in
       sync with the tcp_offset_x parameter in omx_bringup/config/joint_limits.yaml. -->
  <joint name="tcp_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="tcp"/>

  <!-- ===================== wrist camera ===================== -->
  <!-- TODO calibrate: placeholder pose. Camera body mounted on the gripper pan link,
       looking along the approach axis (+x of link5), tilted 20 deg down. -->
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="link5"/>
    <child link="wrist_camera_link"/>
    <origin rpy="0 0.349 0" xyz="0.02 0 0.05"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="camera"/>
    </visual>
  </link>
  <!-- ROS optical frame convention: z forward, x right, y down -->
  <joint name="wrist_camera_optical_joint" type="fixed">
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <link name="wrist_camera_optical_frame"/>

</robot>
