# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# OMX GPU workflow
# Upstream's bare `data` pattern matches a directory named data at ANY depth,
# which would silently swallow the omx.data python package. Re-include it.
!omx/data/
!omx/data/**
omx/data/__pycache__/
config/cpu_sync.env
cpu_sync.env
*.pem

# GPU->Jetson handoff bundle (regenerate with scripts/make_jetson_handoff.py)
jetson_handoff/

# handoff zip (regenerate with scripts/make_jetson_handoff.py)
omx_jetson_handoff_*.zip

jetson_inference_source/
jetson_inference_source_*.tar.gz*

# upstream UMI sample dataset, 17 GB -- downloaded, never source
cup_in_the_wild.zarr.zip

# sim_umi generated artifacts (regenerate with the scripts)
sim_umi/data/*.npz
sim_umi/data/*.zarr.zip
sim_umi/outputs/
sim_umi/data/train/
sim_umi/data/heldout/
sim_umi/data/val/

# definitive-run artefacts: keep sidecars, manifests and logs, never the weights
sim_umi/train_results/**/*.ckpt
sim_umi/train_results/**/*.ckpt.tmp
sim_umi/train_results/**/*.pt
sim_umi/train_results/**/wandb/

# definitive evaluation: raw rollout logs stay on disk; git carries the .json.gz copies
sim_umi/eval_results/2026-09-27_definitive/nominal_*.json
sim_umi/eval_results/2026-09-27_definitive/val18_*.json
sim_umi/eval_results/2026-09-27_definitive/superseded_start_order_bug/nominal_*.json
