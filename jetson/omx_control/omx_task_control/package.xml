<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_task_control</name>
  <version>0.1.0</version>
  <description>Task-space to joint-space layer: action chunk executor (relative EE chunk to absolute targets) and analytic 5-DOF IK node for the OMX-F arm.</description>
  <maintainer email="wogus061@gmail.com">jK</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>omx_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>python3-numpy</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
