<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omx_supervisor</name>
  <version>0.1.0</version>
  <description>mode_manager: the single publisher of /joint_command. Mode switching (IDLE, HOME, POLICY, TELEOP, STOP), e-stop, policy heartbeat watchdog, torque control.</description>
  <maintainer email="wogus061@gmail.com">jK</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>omx_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
